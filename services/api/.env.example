# ── Lentik API — пример переменных окружения ──────────────────────────────
# Скопируйте в .env и подставьте реальные значения. НИКОГДА не коммитьте .env.
#
#   cp .env.example .env
#
# Все настройки читаются pydantic-settings (services/api/app/core/config.py).
# Пустые значения игнорируются (env_ignore_empty=True) — лишнее можно оставить.

# ── База данных ───────────────────────────────────────────────────────────
# asyncpg-драйвер обязателен. Для Docker — db:5432; локально — 127.0.0.1:5432.
DATABASE_URL=postgresql+asyncpg://lentik:CHANGE_ME@127.0.0.1:5432/lentik

# ── Секрет JWT (ОБЯЗАТЕЛЬНО ≥ 32 символа) ─────────────────────────────────
# Приложение откажется стартовать с коротким/пустым секретом.
# Генерация:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS

# ── Загрузки ──────────────────────────────────────────────────────────────
# Относительный путь от services/api/ к общему хранилищу.
UPLOAD_DIR=../../services/cloud/uploads

# Backend: local (локальный диск) или s3. Для multi-instance — s3.
STORAGE_BACKEND=local
# S3 (только при STORAGE_BACKEND=s3):
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ADDRESSING_STYLE=virtual

# ── Режим окружения ───────────────────────────────────────────────────────
# false для локальной разработки. В проде true:
#   • cookie получает Secure + SameSite=None
#   • включается HSTS
#   • ЛЮБОЙ http://, localhost или 127.0.0.1 в CORS_ORIGINS крашит старт.
IS_PRODUCTION=false

# Применять alembic upgrade heads на старте. В проде — false + отдельный шаг.
STRICT_MIGRATIONS=false
AUTO_MIGRATE=true

# ── CORS (список origin фронтенда; ОБЯЗАТЕЛЬНО точные https-URL) ───────────
# Звёздочка '*' запрещена валидатором (CWE-942: credentials+wildcard = дыра).
# В проде IS_PRODUCTION=true отвергнет любой http/localhost origin.
# Формат: JSON-массив или значения через запятую.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Масштабирование (необязательно) ───────────────────────────────────────
# Общий Redis для WS-fan-out и общих rate-лимитеров. Пусто → in-memory.
# REDIS_URL=redis://redis:6379/0

# Запускать in-process планировщик напоминаний. На web-инстансах можно off.
SCHEDULER_ENABLED=true

# ── Аккаунт разработчика (god-mode + /admin) ──────────────────────────────
# Username единственного платформенного админа. На старте ему ставится
# is_developer=True (обходит ВСЕ проверки прав во ВСЕХ семьях). Пусто → выключено.
# ТОЛЬКО для доверенных окружений; в проде — с крайней осторожностью.
DEVELOPER_USERNAME=

# ── Web Push / VAPID (необязательно) ──────────────────────────────────────
# Пусто → push выключен. Генерация:
#   pip install py-vapid && vapid --gen
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@lentik.app
