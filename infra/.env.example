# ── Lentik infra — пример переменных окружения ────────────────────────────
# Скопируйте в .env и подставьте реальные значения. НИКОГДА не коммитьте .env.
#
#   cp .env.example .env
#
# Используется docker-compose.yml (services/api/.env дублирует часть значений
# для локального запуска без Docker).

# ── База данных ───────────────────────────────────────────────────────────
# Сильный пароль, НЕ равный username. Генерация:
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Секрет JWT (ОБЯЗАТЕЛЬНО ≥ 32 символа) ─────────────────────────────────
# Приложение откажется стартовать с коротким/пустым секретом.
# Генерация:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS

# ── Ключ шифрования бэкапов (ОБЯЗАТЕЛЕН) ──────────────────────────────────
# AES-256 GPG-архив; backup-сервис откажется стартовать без ключа.
# Генерация:
#   openssl rand -base64 48
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BASE64_48_CHARS

# ── Режим окружения ───────────────────────────────────────────────────────
# false для локальной разработки. В проде true меняет поведение cookie/HSTS/CORS.
IS_PRODUCTION=false

STRICT_MIGRATIONS=false

# ── Фронтенд (build-time для Next.js static export) ───────────────────────
# Локально — http/ws + localhost; в проде — https/wss + реальный домен API.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# ── Аккаунт разработчика (god-mode + /admin) ──────────────────────────────
# Username платформенного админа. Пусто → выключено.
# ТОЛЬКО для доверенных окружений.
DEVELOPER_USERNAME=

# ── Бэкапы (необязательно) ────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# Offsite-копия в S3/совместимое хранилище (пусто → выключено):
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=
